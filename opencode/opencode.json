{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "username": "denis",
  "default_agent": "ami",
  "server": {
    "hostname": "127.0.0.1"
  },
  "plugin": [
    "opencode-skills-collection@latest",
    "/Users/denis/.config/opencode/plugins/amori-gateway.js"
  ],
  "compaction": {
    "auto": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "backups/**",
      "logs/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git reset --hard*": "deny",
      "git clean -fd*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "git commit *": "ask",
      "git push *": "ask"
    },
    "external_directory": {
      "~/.agents/skills/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/ai-infra/**": "ask",
      "~/github/**": "ask",
      "~/Documents/**": "ask"
    }
  },
  "mcp": {
    "amori": {
      "type": "local",
      "command": [
        "/Users/denis/ai-infra/mcp/run.sh"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "/Users/denis/.hermes/node/bin/mcp-server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/Users/denis/.mcp-shared/memory.json"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/Users/denis/.hermes/node/bin/mcp-server-sequential-thinking"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "/Users/denis/ai-infra/mcp/run-fetch.sh"
      ],
      "enabled": true
    }
  },
  "provider": {
    "ollama-mac": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Mac local, always on)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:1.7b": {
          "name": "Qwen3 1.7B (routing)",
          "limit": {"context": 8192, "output": 512}
        },
        "qwen3-vl:2b": {
          "name": "Qwen3-VL 2B (local vision)",
          "limit": {"context": 8192, "output": 1024}
        },
        "qwen3:4b": {
          "name": "Qwen3 4B (fast local chat)",
          "limit": {"context": 8192, "output": 512}
        },
        "amori-hermes:4b": {
          "name": "Qwen3 4B 64K (Hermes)",
          "limit": {"context": 16384, "output": 2048}
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (denis-k via Tailscale)",
      "options": {
        "baseURL": "http://[fd7a:115c:a1e0::b43b:954]:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b-q4_K_M": {
          "name": "Qwen3.6 35B A3B Q4_K_M (универсальный анализ)",
          "limit": {"context": 32768, "output": 4096}
        },
        "qwen3.6:27b-q4_K_M": {
          "name": "Qwen3.6 27B Q4_K_M (код и сложные задачи)",
          "limit": {"context": 32768, "output": 4096}
        },
        "gemma4:12b-it-qat": {
          "name": "Gemma4 12B IT QAT (быстрый чат)",
          "limit": {"context": 16384, "output": 1024}
        }
      }
    },
    "ollama-ipv4-fallback": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama IPv4 fallback (when Mac VPN route is fixed)",
      "options": {"baseURL": "http://100.77.9.84:11434/v1"},
      "models": {
        "qwen3.6:35b-a3b-q4_K_M": {"name": "Qwen3.6 35B A3B Q4_K_M (универсальный анализ)", "limit": {"context": 32768, "output": 4096}},
        "qwen3.6:27b-q4_K_M": {"name": "Qwen3.6 27B Q4_K_M (код и сложные задачи)", "limit": {"context": 32768, "output": 4096}},
        "gemma4:12b-it-qat": {"name": "Gemma4 12B IT QAT (быстрый чат)", "limit": {"context": 16384, "output": 1024}}
      }
    }
  },
  "skills": {
    "paths": [
      "/Users/denis/.agents/skills",
      "/Users/denis/.config/opencode/skills",
      "/Users/denis/.cache/opencode/packages/@dietrichgebert/ponytail@latest/node_modules/@dietrichgebert/ponytail/skills"
    ]
  },
  "agent": {
    "ami": {
      "description": "Unified Ami entry point with automatic local/Codex/Claude routing",
      "mode": "primary",
      "model": "ollama-mac/qwen3:1.7b",
      "tools": {"*": false},
      "maxSteps": 2,
      "prompt": "The Ami gateway hook replaces every user message with a completed result. Return the text after [AMORI_GATEWAY_RESULT] exactly and never solve a task yourself."
    },
    "amori": {
      "description": "Compatibility alias for the unified Ami entry point",
      "mode": "subagent",
      "model": "ollama-mac/qwen3:1.7b",
      "tools": {"*": false},
      "maxSteps": 2,
      "prompt": "The Amori gateway hook replaces every user message with a completed result. Return the text after [AMORI_GATEWAY_RESULT] exactly and never solve a task yourself."
    },
    "chat-mac": {
      "description": "Fast private chat on the always-on Mac Ollama",
      "model": "ollama-mac/qwen3:1.7b",
      "tools": {"*": false},
      "prompt": "Answer the user directly in natural language. Never emit tool-call JSON, function arguments, hidden reasoning, or implementation metadata."
    },
    "hermes-mac": {
      "description": "Local tool-oriented analysis on the always-on Mac Ollama",
      "model": "ollama-mac/amori-hermes:4b"
    },
    "vision-mac": {
      "description": "Private image and screenshot analysis on the always-on Mac Ollama",
      "model": "ollama-mac/qwen3-vl:2b"
    },
    "code-local": {
      "description": "Local code work on denis-k Ollama through Tailscale IPv6",
      "model": "ollama/qwen3.6:27b-q4_K_M"
    },
    "analysis-local": {
      "description": "Private local analysis on denis-k Ollama through Tailscale IPv6",
      "model": "ollama/qwen3.6:35b-a3b-q4_K_M"
    },
    "chat-local": {
      "description": "Fast local chat on denis-k Ollama through Tailscale IPv6",
      "model": "ollama/gemma4:12b-it-qat"
    }
  }
}
