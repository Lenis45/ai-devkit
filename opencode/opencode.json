{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "username": "denis",
  "server": {
    "hostname": "127.0.0.1"
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "opencode-skills-collection@latest"
  ],
  "compaction": {
    "auto": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "backups/**",
      "logs/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git reset --hard*": "deny",
      "git clean -fd*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "git commit *": "ask",
      "git push *": "ask"
    },
    "external_directory": {
      "~/.agents/skills/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/ai-infra/**": "ask",
      "~/github/**": "ask",
      "~/Documents/**": "ask"
    }
  },
  "mcp": {
    "amori": {
      "type": "local",
      "command": [
        "/Users/denis/ai-infra/mcp/run.sh"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "/Users/denis/.hermes/node/bin/mcp-server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "/Users/denis/.mcp-shared/memory.json"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/Users/denis/.hermes/node/bin/mcp-server-sequential-thinking"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "/Users/denis/ai-infra/mcp/run-fetch.sh"
      ],
      "enabled": false
    }
  },
  "provider": {
    "ollama-mac": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Mac local, always on)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:1.7b": {
          "name": "Qwen3 1.7B (routing)"
        },
        "qwen3-vl:2b": {
          "name": "Qwen3-VL 2B (local vision)"
        },
        "qwen3:4b": {
          "name": "Qwen3 4B (fast local chat)"
        },
        "amori-hermes:4b": {
          "name": "Qwen3 4B 64K (Hermes)"
        }
      }
    },
    "ollama-windows": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Windows GPU via Tailscale)",
      "options": {
        "baseURL": "http://[fd7a:115c:a1e0::b43b:954]:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b-q4_K_M": {
          "name": "Qwen3.6 35B A3B (analysis)"
        },
        "qwen3.6:27b-q4_K_M": {
          "name": "Qwen3.6 27B (code)"
        },
        "gemma4:12b-it-qat": {
          "name": "Gemma4 12B (fast chat)"
        }
      }
    }
  },
  "agent": {
    "chat-mac": {
      "description": "Fast private chat on the always-on Mac Ollama",
      "model": "ollama-mac/qwen3:1.7b"
    },
    "hermes-mac": {
      "description": "Local tool-oriented analysis on the always-on Mac Ollama",
      "model": "ollama-mac/amori-hermes:4b"
    },
    "vision-mac": {
      "description": "Private image and screenshot analysis on the always-on Mac Ollama",
      "model": "ollama-mac/qwen3-vl:2b"
    },
    "code-windows": {
      "description": "Local code work on the optional Windows GPU node",
      "model": "ollama-windows/qwen3.6:27b-q4_K_M"
    },
    "analysis-windows": {
      "description": "Private analysis on the optional Windows GPU node",
      "model": "ollama-windows/qwen3.6:35b-a3b-q4_K_M"
    }
  }
}
